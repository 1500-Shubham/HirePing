meta {
  name: Update Profile
  type: http
  seq: 5
}

put {
  url: http://localhost:4000/api/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "phone": "9876543210",
    "location": "Bangalore, India",
    "summary": "Backend developer with 2 years of experience",
    "skills": ["Node.js", "Python", "MongoDB", "AWS"],
    "education": [
      {
        "degree": "B.Tech Computer Science",
        "institution": "IIT Delhi",
        "year": "2024"
      }
    ],
    "experience": [
      {
        "title": "Backend Developer",
        "company": "Newron",
        "duration": "2 years",
        "highlights": ["Built REST APIs", "Managed MongoDB clusters"]
      }
    ]
  }
}
